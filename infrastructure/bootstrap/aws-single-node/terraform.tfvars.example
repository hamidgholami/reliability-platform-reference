# Copy this file to terraform.tfvars, which Git ignores, and replace every
# example value. Use the narrowest practical operator CIDR, normally /32.
owner          = "replace-with-your-github-handle"
created_at     = "2026-09-08T12:00:00Z"
expires_at     = "2026-09-08T20:00:00Z"
operator_cidr  = "192.0.2.1/32"
ssh_public_key = "ssh-ed25519 replace-with-public-key-material"
